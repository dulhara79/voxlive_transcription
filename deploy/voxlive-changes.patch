+
+    async def get_user_in_organization_by_email(
+        self, email: str, organization_id: str
+    ) -> Optional[User]:
+        needle = email.strip().lower()
+        for user in self._users.values():
+            if user.email == needle and user.organization_id == organization_id:
+                return user
