# Backend WebSocket origin. Default works for local dev; no need to set this
# unless your backend runs elsewhere.
VITE_WS_URL=ws://localhost:8000

# ---------------------------------------------------------------------------
# DEVELOPMENT IDENTITY  (temporary — removed when Cognito lands)
#
# The backend refuses anonymous WebSocket connections and closes them with
# code 1008. Until there is a real login, the frontend asserts an identity
# here. These ids come from backend/app/tenant/seed.py:
#
#   org_dev_acme    ACME Media           Business plan, 25 concurrent
#     usr_dev_alice   admin
#     usr_dev_bob     member
#     usr_dev_carol   viewer   <- authenticates, but CANNOT start a session
#
#   org_dev_globex  Globex Broadcasting  Starter plan, 5 concurrent
#     usr_dev_dave    owner    <- use this to see the quota limit quickly
#
#   org_dev_suspended  Initech           SUSPENDED, always refused
#     usr_dev_erin    owner
#
# This is NOT authentication — the server trusts what the browser sends, which
# is why DevPrincipalResolver refuses to start unless APP_ENV=development.
# ---------------------------------------------------------------------------
VITE_ORG_ID=org_dev_acme
VITE_USER_ID=usr_dev_alice