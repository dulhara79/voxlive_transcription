# Backend HTTP origin, used for /auth/signup, /auth/login and /auth/me.
VITE_API_URL=http://localhost:8000

# Backend WebSocket origin.
VITE_WS_URL=ws://localhost:8000

# ---------------------------------------------------------------------------
# Identity now comes from signing in. The frontend stores the token returned by
# POST /auth/login and sends it as ?token= on every WebSocket connection.
#
# The two variables below are a DEVELOPMENT ESCAPE HATCH for the load harness
# only -- they let a script open a socket without a login. The backend ignores
# them unless APP_ENV=development, because DevPrincipalResolver refuses to
# construct outside it, so leaving them set cannot weaken a deployed
# environment. Leave them blank for normal use.
#
# Seeded development accounts (backend/app/tenant/seed.py) all share the
# password `voxlive-dev-password`:
#
#   org_dev_acme    ACME Media           Business plan, 25 concurrent
#     alice@acme.example    admin
#     bob@acme.example      member
#     carol@acme.example    viewer   <- signs in, but CANNOT start a session
#
#   org_dev_globex  Globex Broadcasting  Starter plan, 5 concurrent
#     dave@globex.example   owner    <- use this to hit the quota quickly
#
#   org_dev_suspended  Initech           SUSPENDED, always refused
#     erin@initech.example  owner
# ---------------------------------------------------------------------------
VITE_ORG_ID=
VITE_USER_ID=
