# ============================================================
# VoxLive .env — v10
# Copy to .env. Make sure .env is in .gitignore.
# ============================================================

# ---- Gemini auth (Vertex AI service account) ----
GEMINI_USE_VERTEX=true
GOOGLE_CLOUD_PROJECT=moj-transcription-project

# NOT "global". The global endpoint routes every call through Google's global
# front door: fine for throughput, bad for tail latency, and latency is the
# whole point. asia-south1 (Mumbai) is normally closest from Sri Lanka;
# asia-southeast1 (Singapore) is the usual second choice. Try both and keep
# the faster one — it is a two-minute experiment worth 100-300 ms per call.
GOOGLE_CLOUD_LOCATION=asia-south1

# Windows paths with spaces are fine unquoted here, but verify the file
# actually exists at startup — a missing credential file fails late and
# confusingly, as an auth error on the first segment rather than on boot.
GOOGLE_APPLICATION_CREDENTIALS=C:\Users\dulha\Downloads\GitHub\voxlive-gemini\backend\test-other projects-chatbot customer.json

# ---- Model ----
ASR_PROVIDER=gemini
GEMINI_MODEL=gemini-3.6-flash
# Flash-tier models think before answering by default. Transcription has no
# reasoning in it, so that budget is pure latency. 0 = off. Usually worth
# 400-900 ms per call, which at 2-4 calls in flight is most of the delay you
# can actually feel.
GEMINI_THINKING_BUDGET=0

# ---- Language lock (Sinhala / English / Tamil, incl. code-switching) ----
ALLOWED_LANGUAGES=si,en,ta

# ---- Anti-hallucination gates ----
MIN_SEGMENT_RMS=120
MAX_WORDS_PER_SEC=8.0

# ---- Audio / VAD segmentation ----
SAMPLE_RATE=16000
VAD_AGGRESSIVENESS=2

# 320 ms, down from 400. Diarization no longer relies on the VAD catching
# every turn change, so this is now purely a responsiveness knob.
SILENCE_MS=320

# 3500 ms, down from 6000. This is the single biggest perceived-latency
# setting in the file: a continuous talker produced NO text at all until the
# soft cap fired, so v7 was up to six seconds behind before any model ran.
SOFT_MAX_SEGMENT_MS=3500
MAX_SEGMENT_MS=9000
MIN_SEGMENT_MS=300

# ---- Rolling ASR context ----
CONTEXT_SEGMENTS=4

# ============================================================
# DIARIZATION v10 — session-global clustering
# ============================================================
# on | off. The v5-v7 modes (pipeline / pyannote / identify) are gone: they
# were four code paths around the same broken idea, which was deciding a
# speaker once, greedily, from one short embedding.
DIARIZATION_MODE=on

# WHICH ENGINE. embedding | sortformer | auto
#
#   embedding   (default) pyannote WeSpeaker + session-global clustering.
#               Runs on CPU. No speaker ceiling. Recognises a speaker who has
#               been silent for ten minutes. CANNOT represent two people
#               talking at once — it picks one.
#
#   sortformer  NVIDIA Streaming Sortformer. End-to-end, handles overlapping
#               speech, materially better DER (6.6% vs ~10-15% on CALLHOME
#               2-speaker). Three caveats: it wants a GPU, it caps at 4
#               speakers, and it was trained PRIMARILY ON ENGLISH — NVIDIA
#               say so on the model card. Diarization keys on voice rather
#               than words so it usually transfers, but Sinhala and Tamil are
#               untested. A/B it on your own recordings before trusting it.
#
#   auto        sortformer only if NeMo imports AND CUDA is visible. Never
#               silently puts Sortformer on a CPU: that turns a 200 ms pass
#               into a multi-second one and looks like a hang, not a setting.
DIARIZATION_BACKEND=embedding

# Sortformer only: how much audio each pass re-diarizes. Identity across the
# seam is stitched by matching speakers on the overlap, so a speaker silent
# for LONGER than this window comes back with a new name. Larger = safer,
# and cost scales linearly (RTF ~0.002 on an RTX 6000).
SORTFORMER_WINDOW_SEC=90

# Speaker count, when you know it. Treated as a CEILING, not a quota — with
# EXPECTED_SPEAKERS=2 and only one person talking you get one speaker, not a
# monologue chopped between two. 0 = auto.
EXPECTED_SPEAKERS=2
MAX_SPEAKERS=6

# How often a background diarization pass runs. Lower = the first render of a
# line is more often already correct; higher = fewer, larger embedding batches.
# 1.5 s is a good default. Below ~1.0 s you pay framework overhead for two
# windows of audio.
DIARIZE_INTERVAL_SEC=1.5

# How long a finished segment waits for the timeline to reach it before
# shipping with a best-effort label. A `refresh` corrects it either way, so
# this only buys a nicer first paint. Keep it under the pass interval.
DIARIZE_WAIT_MS=900

# NOTE: DIARIZATION_THRESHOLD and DIARIZATION_NEW_SPEAKER_MARGIN are GONE.
# They are not missing, they are meaningless: the quantity they thresholded
# (embedding cosine distance) depends on turn DURATION as strongly as on
# speaker identity, so no value was ever correct for both a 0.8 s turn and a
# 3 s one. See tests/test_vs_v7.py — sweeping every threshold from 0.30 to
# 0.70 tops out at 57.5% accuracy on a two-speaker conversation.

# ONE gated model to accept, once, while logged in to Hugging Face:
#   https://hf.co/pyannote/wespeaker-voxceleb-resnet34-LM
# speaker-diarization-community-1 is no longer used at all.
# ROTATE THIS TOKEN — the one in this project's history was exposed.
HUGGINGFACE_TOKEN=hf_

# ---- Optional stages ----
ENABLE_POSTPROCESS=false

# ---- Concurrency ----
ASR_CONCURRENCY=6

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173

# ============================================================
# WHAT HEALTHY v10 LOGS LOOK LIKE
# ============================================================
#   loading pyannote/wespeaker-voxceleb-resnet34-LM on cpu ...
#   embedder warm
#   segment 4: 12.30-15.10s (2.80s, silence) rms=1840
#   pass 9: +4 window(s) in 180 ms, covered to 15.20s, 2 speaker(s)
#   recluster: 62 window(s) -> 2 speaker(s) [1, 2], 11 timeline run(s)
#   audio: 60s received, 22 segment(s), diar={'passes': 40, 'windows': 78,
#          'speakers': 2, 'avg_embed_ms': 173.4, 'covered_until': 59.5}
#
# Things to watch:
#   avg_embed_ms  > ~600 on CPU  -> the box is too small; move to GPU or raise
#                                   DIARIZE_INTERVAL_SEC
#   speakers      drifting up    -> set EXPECTED_SPEAKERS instead of auto
#   covered_until far behind     -> passes are not keeping up; raise the
#                                   interval so batches are larger
