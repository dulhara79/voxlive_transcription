# ============================================================
# VoxLive .env — v10
# Copy to .env. Make sure .env is in .gitignore.
# ============================================================

# ---- Gemini auth (Vertex AI service account) ----
GEMINI_USE_VERTEX=true
GOOGLE_CLOUD_PROJECT=moj-transcription-project

# NOT "global". The global endpoint routes every call through Google's global
# front door: fine for throughput, bad for tail latency, and latency is the
# whole point. asia-south1 (Mumbai) is normally closest from Sri Lanka;
# asia-southeast1 (Singapore) is the usual second choice. Try both and keep
# the faster one — it is a two-minute experiment worth 100-300 ms per call.
GOOGLE_CLOUD_LOCATION=global
# Windows paths with spaces are fine unquoted here, but verify the file
# actually exists at startup — a missing credential file fails late and
# confusingly, as an auth error on the first segment rather than on boot.
GOOGLE_APPLICATION_CREDENTIALS=C:\Users\dulha\Downloads\GitHub\voxlive-gemini\backend\test-other projects-chatbot customer.json

# ---- Model ----
ASR_PROVIDER=gemini
GEMINI_MODEL=gemini-3.6-flash
# Flash-tier models think before answering by default. Transcription has no
# reasoning in it, so that budget is pure latency. 0 = off. Usually worth
# 400-900 ms per call, which at 2-4 calls in flight is most of the delay you
# can actually feel.
GEMINI_THINKING_BUDGET=0

# ---- Language lock (Sinhala / English / Tamil, incl. code-switching) ----
ALLOWED_LANGUAGES=si,en,ta

# ---- Anti-hallucination gates ----
MIN_SEGMENT_RMS=120

# TWO rate gates, because neither covers all three languages. Words-per-second
# catches English loops. Sinhala and Tamil agglutinate, so a runaway segment in
# either stays well under the WORD limit while its character count explodes --
# a Sinhala loop can emit 400 characters in 3 s and still measure ~2 w/s.
# Characters-per-second is the scale-free version of the same check. A segment
# only has to trip ONE of them to be dropped.
MAX_WORDS_PER_SEC=8.0
MAX_CHARS_PER_SEC=28.0

# ---- Audio / VAD segmentation ----
SAMPLE_RATE=16000
VAD_AGGRESSIVENESS=2

# 450 ms for this experiment, up from 320. A Sinhala speaker's natural
# within-phrase pause can exceed 320 ms, and when it does the VAD ends the turn
# mid-phrase and Gemini receives a fragment that begins or ends mid-word. A
# fragment is exactly the input a generative model is most likely to "complete"
# rather than transcribe.
#
# This is a HYPOTHESIS, not a known-good value. Sweep it on your own
# recordings: 250 / 320 / 450 / 550, one change at a time.
SILENCE_MS=450

# 3500 ms, down from 6000. This is the single biggest perceived-latency
# setting in the file: a continuous talker produced NO text at all until the
# soft cap fired, so v7 was up to six seconds behind before any model ran.
SOFT_MAX_SEGMENT_MS=3500
MAX_SEGMENT_MS=9000
MIN_SEGMENT_MS=300

# ---- Rolling ASR context ----
# Sent to the model as a spelling/vocabulary hint on every call. It is now
# AUDITED on the way back: if the returned text is mostly a copy of this hint,
# the model continued the prompt instead of reading the audio and the segment
# is dropped (validation.echoes_context). Setting this to 0 disables the hint
# entirely -- which also removes the hallucination class it can cause, at the
# cost of worse proper nouns and code-switch boundaries.
#
# Each segment's call carries up to 1200 extra characters of input because of
# this. That is a real Gemini line item; see deploy/AWS_COST.md.
#
# NOW DEFAULTED TO 0, ON PURPOSE. The reported symptom is Sinhala words in the
# transcript that nobody said. The rolling hint is one mechanism that can
# produce exactly that: the model is handed previous Sinhala text alongside new
# audio and can continue it instead of transcribing. gemini_provider.py says so
# in its own comment ("the model will happily continue the previous sentence").
# echoes_context() catches the blatant case -- output that is mostly a copy --
# but it cannot catch the model borrowing ONE plausible word from the hint,
# which is what a hallucinated word looks like.
#
# So: run with 0 first and compare the SAME audio. If the hallucinated words
# stop, the hint was contributing and this stays off. If they do not, the hint
# is exonerated and the problem is the ASR model or the segmentation -- which
# is worth knowing before changing anything else. Set it back to 4 if proper
# nouns and code-switch boundaries get materially worse.
CONTEXT_SEGMENTS=0

# ============================================================
# DIARIZATION v10 — session-global clustering
# ============================================================
# on | off. The v5-v7 modes (pipeline / pyannote / identify) are gone: they
# were four code paths around the same broken idea, which was deciding a
# speaker once, greedily, from one short embedding.
DIARIZATION_MODE=on

# WHICH ENGINE. embedding | sortformer | auto
#
#   embedding   (default) pyannote WeSpeaker + session-global clustering.
#               Runs on CPU. No speaker ceiling. Recognises a speaker who has
#               been silent for ten minutes. CANNOT represent two people
#               talking at once — it picks one.
#
#   sortformer  NVIDIA Streaming Sortformer. End-to-end, handles overlapping
#               speech, materially better DER (6.6% vs ~10-15% on CALLHOME
#               2-speaker). Three caveats: it wants a GPU, it caps at 4
#               speakers, and it was trained PRIMARILY ON ENGLISH — NVIDIA
#               say so on the model card. Diarization keys on voice rather
#               than words so it usually transfers, but Sinhala and Tamil are
#               untested. A/B it on your own recordings before trusting it.
#
#   auto        sortformer only if NeMo imports AND CUDA is visible. Never
#               silently puts Sortformer on a CPU: that turns a 200 ms pass
#               into a multi-second one and looks like a hang, not a setting.
DIARIZATION_BACKEND=embedding

# Sortformer only: how much audio each pass re-diarizes. Identity across the
# seam is stitched by matching speakers on the overlap, so a speaker silent
# for LONGER than this window comes back with a new name. Larger = safer,
# and cost scales linearly (RTF ~0.002 on an RTX 6000).
SORTFORMER_WINDOW_SEC=90

# ============================================================
# SPEECH / MUSIC GATE  (supervisor review, Fix #4)
# ============================================================
# WebRTC VAD asks "does this look like speech?" and sung vocals pass. RMS is an
# ENERGY gate and music is loud. Neither rejects a song, so until now the only
# thing stopping a Sinhala song being transcribed was a sentence in the Gemini
# prompt asking a generative model to also be an audio classifier.
#
#   off   no gate
#   log   classify and LOG every segment, drop nothing        <-- start here
#   drop  discard segments scoring at or above the threshold
#
# DO NOT ship `drop` before calibrating. Run in `log`, record real Sinhala
# conversation AND real Sinhala songs, then grep the backend log:
#
#     grep 'music-gate:' backend.log
#
# Each line carries the score and all four raw features. Set the threshold
# between the two distributions you actually observe, then switch to `drop`.
# A gate tuned by guesswork that silently eats quiet Sinhala speech is worse
# than no gate: losing real words is invisible, transcribing a song is obvious.
#
# Known weak spots: a cappella singing and rap score speech-like; segments
# under 1.5 s are not judged at all (the gate abstains rather than guessing).
MUSIC_GATE_MODE=log
MUSIC_GATE_THRESHOLD=0.60

# Speaker count, when you know it. WHAT IT MEANS depends on SPEAKER_MODE.
EXPECTED_SPEAKERS=2
MAX_SPEAKERS=6

# SPEAKER_MODE — auto | fixed   (supervisor review, Fix #1)
#
#   auto    EXPECTED_SPEAKERS is a CEILING. K is estimated from the audio, and
#           with EXPECTED_SPEAKERS=2 plus one person talking you get one
#           speaker, not a monologue chopped in two.
#
#   fixed   K IS EXPECTED_SPEAKERS. Nothing may reduce it.
#
# Use `fixed` when you know the count. In `auto`, two speakers whose embedding
# centroids sit closer than SAME_SPEAKER_MAX (0.50) fail the separation veto,
# K falls back to 1, and the whole transcript is relabelled Speaker 1 — which
# is exactly the "Speaker 2 disappeared" symptom. Real podcast voices land at
# 0.43 often enough for this to happen mid-session.
#
# The cost is the mirror image, and it is real: fixed K=2 on a recording where
# only one person speaks WILL split that person into two speakers. Fixed mode
# is a promise about the audio, so only make it when you can keep it.
SPEAKER_MODE=fixed

# Trusted speech required before the speaker structure stops being provisional
# (supervisor review, Fix #2). Below this, passes may still change K — with a
# few seconds of audio they should. Above it, identities are ESTABLISHED: live
# passes adapt centroids and assign new windows to existing speakers, but can
# no longer delete a speaker. Whole-session re-clustering happens once more at
# the end, when you stop recording.
#
#   LIVE  -> stable
#   FINAL -> refined
#
# Raise it if early labels churn; lower it if a genuine second speaker who only
# arrives late takes too long to be recognised.
SPEAKER_ESTABLISH_SEC=8.0

# How often a background diarization pass runs. Lower = the first render of a
# line is more often already correct; higher = fewer, larger embedding batches.
# 1.5 s is a good default. Below ~1.0 s you pay framework overhead for two
# windows of audio.
DIARIZE_INTERVAL_SEC=1.5

# How long a finished segment waits for the timeline to reach it before
# shipping with a best-effort label. A `refresh` corrects it either way, so
# this only buys a nicer first paint. Keep it under the pass interval.
DIARIZE_WAIT_MS=900

# NOTE: DIARIZATION_THRESHOLD and DIARIZATION_NEW_SPEAKER_MARGIN are GONE.
# They are not missing, they are meaningless: the quantity they thresholded
# (embedding cosine distance) depends on turn DURATION as strongly as on
# speaker identity, so no value was ever correct for both a 0.8 s turn and a
# 3 s one. See tests/test_vs_v7.py — sweeping every threshold from 0.30 to
# 0.70 tops out at 57.5% accuracy on a two-speaker conversation.

# ONE gated model to accept, once, while logged in to Hugging Face:
#   https://hf.co/pyannote/wespeaker-voxceleb-resnet34-LM
# speaker-diarization-community-1 is no longer used at all.
# ROTATE THIS TOKEN — the one in this project's history was exposed.
HUGGINGFACE_TOKEN=hf_

# ---- Optional stages ----
ENABLE_POSTPROCESS=false

# ---- Concurrency ----
ASR_CONCURRENCY=6

# ============================================================
# AUTHENTICATION
# ============================================================
# HS256 signing key for the tokens issued by POST /auth/login. Generate one:
#
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# REQUIRED outside APP_ENV=development -- build_resolver() touches it at
# start-up and refuses to boot without it. That is deliberate: every task
# behind the load balancer must sign with the SAME key, or a token minted by
# task A is rejected by task B and logins fail at random. In development an
# ephemeral per-process key is generated instead, so every restart signs
# everyone out.
#
# On AWS this belongs in Secrets Manager and reaches the container as a task
# definition `secrets` entry, never as a plain `environment` value -- the
# latter is visible to anyone who can call DescribeTaskDefinition.
# SET THIS EVEN IN DEVELOPMENT. If it is empty, the backend falls back to a key
# stored in .voxlive_dev_secret (see below) -- which now persists, but is one
# more moving part than simply putting a value here.
AUTH_JWT_SECRET=

# Where the development fallback key is kept when AUTH_JWT_SECRET is empty.
# Before this existed, a NEW random key was generated on every start-up, so
# restarting the backend invalidated every token already in the browser and you
# were bounced to the sign-in screen. Delete this file to sign everyone out.
# It is a credential: keep it out of git.
AUTH_DEV_SECRET_FILE=.voxlive_dev_secret

# How long an access token is valid. It travels in the WebSocket URL as
# ?token=, because the browser WebSocket API cannot set an Authorization
# header -- so it reaches browser history and any proxy that logs query
# strings. Keep this short, and make sure ALB access logging is NOT recording
# query strings.
AUTH_ACCESS_TTL_SEC=43200

# The second step of login, used only when one email + password matches
# accounts in more than one organization. Just long enough to read a list and
# click.
AUTH_ORG_SELECT_TTL_SEC=300

# ============================================================
# TENANT STORAGE
# ============================================================
# Where organizations and users live.
#
#   sqlite:///./voxlive.db   a local file  (default)
#   memory                   dictionaries, wiped on every restart
#
# The default is a FILE. With `memory`, every account you registered was gone
# the moment the process stopped -- which is why signing up again after each
# restart felt like a frontend bug and was not one.
#
# The file is a credential store. Keep it out of git; delete it to start clean.
# A postgresql:// URL is REFUSED rather than quietly downgraded, because
# SqlTenantRepository does not exist yet.
DATABASE_URL=sqlite:///./voxlive.db

# ---- CORS ----
# Must include the origin the frontend is served from, or the browser blocks
# every /auth call before it reaches FastAPI.
CORS_ORIGINS=http://localhost:5173

# ============================================================
# WHAT HEALTHY v10 LOGS LOOK LIKE
# ============================================================
#   loading pyannote/wespeaker-voxceleb-resnet34-LM on cpu ...
#   embedder warm
#   segment 4: 12.30-15.10s (2.80s, silence) rms=1840
#   pass 9: +4 window(s) in 180 ms, covered to 15.20s, 2 speaker(s)
#   recluster: 62 window(s) -> 2 speaker(s) [1, 2], 11 timeline run(s)
#   audio: 60s received, 22 segment(s), diar={'passes': 40, 'windows': 78,
#          'speakers': 2, 'avg_embed_ms': 173.4, 'covered_until': 59.5}
#
# Things to watch:
#   avg_embed_ms  > ~600 on CPU  -> the box is too small; move to GPU or raise
#                                   DIARIZE_INTERVAL_SEC
#   speakers      drifting up    -> set EXPECTED_SPEAKERS instead of auto
#   covered_until far behind     -> passes are not keeping up; raise the
#                                   interval so batches are larger